/dts-v1/;

#include <espressif/esp32c6/esp32c6_wroom_n4.dtsi>
#include "esp32c6_custom_hpcore-pinctrl.dtsi"
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <espressif/partitions_0x0_default.dtsi>

/ {
	model = "ESP32-C6 Custom HP Core";
	compatible = "surya,esp32c6-custom", "espressif,esp32c6";

	chosen {
		zephyr,sram = &sramhp;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,ieee802154 = &ieee802154;
	};

	aliases {
		led0 = &onboard_led;
		watchdog0 = &wdt0;
	};

	leds {
		compatible = "gpio-leds";

		onboard_led: onboard_led {
			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
			label = "Onboard LED";
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&usb_serial {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	sh1106: sh1106@3c {
		compatible = "sinowealth,sh1106-custom";
		reg = <0x3c>;
		status = "okay";
	};
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>, <&gpio0 5 GPIO_ACTIVE_LOW>;

	microsd: microsd@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		spi-max-frequency = <8000000>;
		status = "okay";
	};

	nrf24: nrf24@1 {
		compatible = "nordic,nrf24";
		reg = <1>;
		spi-max-frequency = <8000000>;
		ce-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&gpio0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&wifi {
	status = "okay";
};

&ieee802154 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};
